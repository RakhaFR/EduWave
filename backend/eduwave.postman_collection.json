          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response envelope structure & paginated meta', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.all.keys('success', 'data', 'error', 'meta');",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.meta).to.have.all.keys('current_page', 'per_page', 'total', 'last_page');",
                  "});",
                  "pm.test('Draft courses excluded from guest view', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var statuses = jsonData.data.map(function(c){ return c.status; });",
                  "    pm.expect(statuses).to.not.include('draft');",
                  "});"
                ],
                "type": "text/javascript"
              }
