    "_postman_id": "8f3b2a1c-9d8e-4f7a-8b6c-5d4e3f2a1b0c",
    "name": "EduWave API Test Suite",
    "description": "Comprehensive Postman Collection for EduWave API (Auth, User/Profile, Courses, Lessons, Enrollments, Exams & Attempts, plus Negative/Edge Cases). All requests check HTTP status code and standard JSON response envelope shape (success, data, error, meta). Token capturing and flow chaining are fully automated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
