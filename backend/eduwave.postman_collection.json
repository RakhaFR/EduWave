    {
      "name": "4. Lesson Progress & Completion",
      "item": [
        {
          "name": "4.1 Complete Lesson 1 (First Time - Awards XP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"watch_seconds\": 900\n}"
            },
            "url": {
              "raw": "{{base_url}}/lessons/{{lesson_preview_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["lessons", "{{lesson_preview_id}}", "complete"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response envelope structure', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.all.keys('success', 'data', 'error', 'meta');",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "pm.test('First completion awards XP', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.is_first_completion).to.eql(true);",
                  "    pm.expect(jsonData.data.xp_awarded).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4.2 Complete Lesson 1 AGAIN (Idempotency - No Extra XP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
