  "item": [
    {
      "name": "1. Auth Flow",
      "item": [
        {
          "name": "1.1 Register New User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user_postman_{{$randomInt}}\",\n  \"email\": \"postman_{{$randomInt}}@eduwave.id\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"full_name\": \"Postman Runner User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response envelope structure', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.all.keys('success', 'data', 'error', 'meta');",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.error).to.be.null;",
                  "    pm.expect(jsonData.data).to.have.all.keys('user', 'token', 'token_type');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
